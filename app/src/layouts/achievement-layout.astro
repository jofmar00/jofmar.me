---
import type { Achievement } from '@/types.ts'
import Lightbox from '@/components/lightbox.astro';

interface Props {
    achievement: Achievement
}

const { achievement } = Astro.props;
---

<div class="relative flex flex-row items-center gap-4 rounded-lg bg-surface p-4">
    {achievement.isNew && (
        <span class="absolute -top-2 -right-2 rounded-full bg-red-500 px-1 text-lg leading-tight text-white rotate-12 ">
            new!
        </span>
    )}
    <Lightbox id={`achievement-${achievement.id}`} image={achievement.miniature}>
        <slot></slot>
    </Lightbox>
    <div class="min-w-0 flex-1 flex flex-col gap-1">
        <h2 class="text-xl">{achievement.title}</h2>
        <time datetime={achievement.date} class="text-lg text-[#FFB830]">
            {achievement.date}
        </time>
        <slot></slot>
    </div>
</div>
