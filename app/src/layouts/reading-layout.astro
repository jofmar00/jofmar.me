---
import BaseHead from "@/components/base-head.astro";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import { ROUTES } from "@/consts";
import Image from "astro/components/Image.astro";
import type { ImageMetadata } from "astro";

type Props = {
    path: string;
    post: {
        id: string;
        title: string;
        miniature: ImageMetadata;
        description: string;
        date: string;
        url: string;
    };
};

const { path, post } = Astro.props as Props;
const route = ROUTES.find((r) => r.URL === path);
if (!route) {
    throw new Error(`Route ${path} not found in ROUTES`);
}
---

<!doctype html>
<html lang={Astro.currentLocale}>
    <head>
        <BaseHead />
    </head>
    <body>
        <Header path={path} />
        <main class="mx-auto max-w-2xl px-4 font-baumans pt-12">
            <div class="flex flex-col py-4">
                <h1 class="text-3xl font-semibold">{post.title}</h1>
                <p class="text-subtle">{post.description}</p>
            </div>
            <Image
                src={post.miniature}
                alt=""
                width={400}
                height={225}
                densities={[1, 2]}
                class="aspect-video w-full object-cover mb-4"
                transition:name={`post-${post.id}`}
            />
            <time class="font-semibold" datetime={post.date}>{post.date}</time>
            <hr class="my-4 border-dashed border-t-2">
            <!-- Content -->
            <slot />
        </main>
        <Footer />
    </body>
</html>
