---
import type { Route } from "@/types";
import { t } from "@/lib/i18n";

interface SectionProps {
    route: Route;
}

const { route } = Astro.props as SectionProps;
const title = t(route.TITLE, Astro.currentLocale);
const description = t(route.DESCRIPTION, Astro.currentLocale);
---

<div class="flex flex-col pt-8 mx-auto">
    <div class="flex flex-row space-x-6">
        <span
            class="route-icon route-icon-display size-20 -rotate-12 sm:size-16"
            style={`--icon-url: url(${route.ICON}); color: ${route.COLOR};`}
            role="img"
            aria-label={title}
            transition:name={`icon-${route.URL}`}
        />
        <div class="flex flex-col font-sniglet">
            <h1 class="text-2xl font-semibold" style={`color: ${route.COLOR}`}>{title}</h1>
            <p class="text-md">{description}</p>
        </div>
    </div>
</div>
<hr class="my-8 border-t" >
 