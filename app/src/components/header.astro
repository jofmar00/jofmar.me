---
import { SITE } from "@/consts";
import "@/styles/global.css"

interface HeaderProps {
   path: string
}

const { path } = Astro.props as HeaderProps;
---
<header class="font-baumans">
    <h2 class="text-2xl p-5 flex gap-1 justify-center">
        <a href="/" class="hover:underline">{SITE.URL}</a>
        <a href={path} class="hover:underline">{path}</a>
    </h2>

</header>