---
import type { ImageMetadata } from 'astro';
import Lightbox from '@/components/lightbox.astro';

interface Props {
    image: ImageMetadata;
    alt?: string;
    caption?: string;
    size?: keyof typeof sizes;
    id?: string;
}

const sizes = {
    sm: "w-sm",
    md: "w-2xl",
    lg: "w-4xl",
};

const { image, caption, alt = caption ?? "", size = "md", id = crypto.randomUUID() } = Astro.props;
---

<figure class="mx-auto w-fit text-center">
    <Lightbox id={id} image={image} alt={alt} class="mx-auto block w-fit" thumbnailClass={`${sizes[size]} max-w-full rounded-lg`} thumbnailWidth={600}>
        {caption}
    </Lightbox>
    {caption && <figcaption>{caption}</figcaption>}
</figure>
