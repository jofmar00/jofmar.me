---
import type { ImageMetadata } from 'astro';
import Lightbox from '@/components/lightbox.astro';

type CarouselImage = ImageMetadata | { image: ImageMetadata; alt?: string; caption?: string };

interface Props {
    images: CarouselImage[];
    size?: keyof typeof sizes;
    loop?: boolean;
}

const sizes = {
    sm: "max-w-sm",
    md: "max-w-2xl",
    lg: "max-w-4xl",
};

const { images, size = "md", loop = true } = Astro.props;

const slides = images.map((item) => {
    const { image, alt, caption } = "image" in item ? item : { image: item, alt: undefined, caption: undefined };
    return { image, caption, alt: alt ?? caption ?? "", id: crypto.randomUUID() };
});
---

<figure class:list={["not-prose mx-auto w-full", sizes[size]]} data-carousel data-loop={loop ? "true" : "false"}>
    <div class="relative">
        <div class="overflow-hidden rounded-lg" data-carousel-viewport>
            <div class="flex touch-pan-y">
                {slides.map(({ image, alt, caption, id }) => (
                    <div class="min-w-0 shrink-0 grow-0 basis-full">
                        <Lightbox id={id} image={image} alt={alt} class="block w-full" thumbnailClass="aspect-[4/3] w-full object-cover" thumbnailWidth={900}>
                            {caption}
                        </Lightbox>
                        {caption && <figcaption class="mt-2 text-center">{caption}</figcaption>}
                    </div>
                ))}
            </div>
        </div>

        {slides.length > 1 && (
            <>
                <button
                    type="button"
                    data-carousel-prev
                    class="absolute top-1/2 left-2 flex size-14 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white disabled:opacity-30"
                    aria-label="Imagen anterior"
                >
                    <svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6" /></svg>
                </button>
                <button
                    type="button"
                    data-carousel-next
                    class="absolute top-1/2 right-2 flex size-14 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white disabled:opacity-30"
                    aria-label="Imagen siguiente"
                >
                    <svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg>
                </button>
            </>
        )}
    </div>

    {slides.length > 1 && (
        <div class="mt-3 flex justify-center gap-2" data-carousel-dots>
            {slides.map((_, i) => (
                <button type="button" class="size-2.5 rounded-full bg-current opacity-30 transition-opacity data-[selected]:opacity-100" aria-label={`Ir a la imagen ${i + 1}`} />
            ))}
        </div>
    )}
</figure>

<script>
    import EmblaCarousel from 'embla-carousel';

    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
            const viewport = root.querySelector<HTMLElement>('[data-carousel-viewport]')!;
            const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
            const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
            const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-carousel-dots] button')];

            const embla = EmblaCarousel(viewport, { loop: root.dataset.loop === "true" });

            prev?.addEventListener('click', () => embla.scrollPrev());
            next?.addEventListener('click', () => embla.scrollNext());
            dots.forEach((dot, i) => dot.addEventListener('click', () => embla.scrollTo(i)));

            const update = () => {
                const selected = embla.selectedScrollSnap();
                dots.forEach((dot, i) => dot.toggleAttribute('data-selected', i === selected));
                if (prev) prev.disabled = !embla.canScrollPrev();
                if (next) next.disabled = !embla.canScrollNext();
            };

            embla.on('select', update).on('reInit', update);
            update();
        });
    });
</script>
