---
import PageLayout from "@/layouts/page-layout.astro";
import { t } from "@/lib/i18n";

const BACK_HOME = { es: "Volver a la página principal", en: "Back to the homepage" };
---
<PageLayout path="/404">
    <main class="mx-auto max-w-2xl px-4 font-baumans pt-12 flex flex-col items-center">
		<h1 class="text-2xl mb-4 mx-auto">
			No hemos encontrado la ruta que estabas buscando...
		</h1>
		<img src="/gifs/penguin-sweeping.gif" alt="Penguin sweeping" />
		<p class="text-center text-md">Sospechoso......</p>
		<a href="/" class="mt-6 flex items-center gap-2 hover:underline">
			<span class="route-icon-display size-12" style="--icon-url: url(/icons/globe.svg);"></span>
			<p class="text-lg">{t(BACK_HOME, Astro.currentLocale)}</p>
			
		</a>
	</main>
</PageLayout>