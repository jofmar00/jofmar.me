---
import PageLayout from "@/layouts/page-layout.astro"
import ReadingPreviewLayout from "@/layouts/reading-preview-layout.astro";
import { getCollection } from "astro:content"
import { t } from "@/lib/i18n";

const entries = await getCollection("blog", ({ data }) => data.published);
const NO_POSTS = { es: "Todavía no hay contenido publicado", en: "There's no published content yet" };
---
<PageLayout path="/blog">
    {entries.length === 0 ? (
        <p class="text-center text-3xl text-muted mt-20">{t(NO_POSTS, Astro.currentLocale)}</p>
    ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {entries.map((post) => (
                <ReadingPreviewLayout post={{
                    id: post.id,
                    title: post.data.title,
                    description: post.data.description,
                    date: post.data.date.toLocaleDateString(),
                    miniature: post.data.miniature
                }}></ReadingPreviewLayout>
            ))}
        </div>
    )}
</PageLayout>