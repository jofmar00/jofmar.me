---
import { Image } from "astro:assets";
import BaseHead from "@/components/base-head.astro";
import type { Route } from "@/types";
import { ROUTES, SITE } from "@/consts";
import { t } from "@/lib/i18n"; import jofmarImage from "@/assets/jofmar.jpeg";
import "@/styles/global.css";
---

<html lang={Astro.currentLocale}>
	<head>
		<BaseHead />
	</head>
	<body class="font-baumans">
		<main class="mx-auto max-w-2xl px-4">
		<div
			class="flex flex-col sm:flex-row items-center justify-center gap-5 mt-8 mb-20"
			transition:name="fade" >
			<Image
				src={jofmarImage}
				alt=""
				width={128}
				height={128}
				densities={[1, 2]}
				class="w-32 h-32 rounded-full object-cover"
			/>
			<div class="flex-r max-sm:text-center">
				<h1 class="text-2xl">{SITE.TITLE}</h1>
				<h2 class="text-lg text-subtle">{t(SITE.DESCRIPTION, Astro.currentLocale)}</h2>
			</div>
		</div>

		<!-- Sites -->
		<div class="grid grid-cols-2 gap-y-6 md:grid-cols-4">
			{
				ROUTES.filter((r: Route) => !r.HIDDEN).map((r: Route) => (
					<a
						href={r.URL}
						class="route-link group flex flex-col items-center gap-2 text-center hover:underline"
						style={`--icon-url: url(${r.ICON}); --hover-color: ${r.COLOR}`}
					>
						<span class="relative">
							<span
								class="route-icon-display size-10 transition-transform group-hover:scale-110"
								role="img"
								aria-label={t(r.TITLE, Astro.currentLocale)}
								transition:name={`icon-${r.URL}`}
							/>
							{r.NEW && (
								<span class="absolute -top-2 -right-3 rounded-full bg-red-500 px-1 text-sm leading-tight text-white rotate-12">
									new!
								</span>
							)}
						</span>
						{t(r.TITLE, Astro.currentLocale)}
					</a>
				))
			}
		</div>

		<div class="mt-12 flex flex-col items-center justify-center gap-4">
			<p>Esta página sigue en construcción...</p>
			<img src="/gifs/penguin-drill.gif" alt="Penguin drill" class="h-48" />
		</div>
		</main>
	</body>
</html>

<style>
		@keyframes doodle-wobble {
		0%,
		100% {
			transform: rotate(2deg);
		}
		14% {
			transform: rotate(-5deg);
		}
		28% {
			transform: rotate(4deg);
		}
		42% {
			transform: rotate(-3deg);
		}
		57% {
			transform: rotate(6deg);
		}
		71% {
			transform: rotate(-4deg);
		}
		85% {
			transform: rotate(5deg);
		}
	}

	.route-icon-display {
		transition: background-color 0.1s;
	}

	.group:hover .route-icon-display {
		animation: doodle-wobble 3.33s steps(1) infinite;
	}
</style>
