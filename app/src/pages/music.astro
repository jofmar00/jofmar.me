---
import PageLayoutComponent from "@/layouts/page-layout.astro";
import SongLayout from "@/layouts/song-layout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("music");
---

<PageLayoutComponent path="/music">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        {entries.map((s) => <SongLayout song={s} />)}
    </div>
</PageLayoutComponent>
