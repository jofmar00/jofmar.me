---
import AchievementLayout from "@/layouts/achievement-layout.astro";
import PageLayoutComponent from "@/layouts/page-layout.astro"
import { getCollection, render } from "astro:content"

const entries = await getCollection("achievements");
const rendered = await Promise.all(entries.map(async (a) => ({
    entry: a,
    Content: (await render(a)).Content,
})));
const now = new Date();
---
<PageLayoutComponent path="/achievements">
    <div class="flex flex-col gap-4">
        {rendered.map(({ entry: a, Content }) => (
            <AchievementLayout achievement={{
                id: a.id,
                title: a.data.title,
                date: a.data.date.toLocaleString("es", {
                    day: "numeric",
                    weekday: "long",
                    month: "long",
                    year: "numeric",
                }),
                miniature: a.data.miniature,
                isNew: (now.getTime() - a.data.date.getTime()) / (1000 * 60 * 60 * 24) <= 7
            }}>
                <Content />
            </AchievementLayout>
        ))}
    </div>
</PageLayoutComponent>